# LyricFlow Environment Configuration
# Copy this file to .env.local (which is gitignored) and populate values as needed.
# Never commit actual API keys or secrets to version control.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# HTTPS origin of the existing Express server (no /music path).
# Required for server-backed lyrics and online catalogs inside a bundled APK.
# VITE_ values are public build configuration, never server credentials.
VITE_BACKEND_URL=
# Optional separate music resolver endpoint, including its path if needed.
VITE_MUSIC_RESOLVER=

# Use the SAME Firebase project/database in web and Android.
# See FIREBASE_SETUP.md. Firebase web config is public; service-account keys are not.
