    "@fontsource/anton": "^5.2.0",
    "@fontsource/bebas-neue": "^5.2.0",
    "@fontsource/black-ops-one": "^5.2.0",
    "@fontsource/bodoni-moda": "^5.2.0",
    "@fontsource/bricolage-grotesque": "^5.2.0",
    "@fontsource/bungee-shade": "^5.2.0",
    "@fontsource/caveat": "^5.2.0",
    "@fontsource/chakra-petch": "^5.2.0",
    "@fontsource/cinzel-decorative": "^5.2.0",
    "@fontsource/cormorant-garamond": "^5.2.0",
    "@fontsource/fraunces": "^5.2.0",
    "@fontsource/gloock": "^5.2.0",
    "@fontsource/italiana": "^5.2.0",
    "@fontsource/marcellus": "^5.2.0",
    "@fontsource/michroma": "^5.2.0",
    "@fontsource/noto-sans-devanagari": "^5.3.0",
    "@fontsource/noto-sans-malayalam": "^5.3.0",
    "@fontsource/noto-sans-tamil": "^5.3.0",
