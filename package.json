{
  "name": "lyricsflow-android",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "dev:full": "node scripts/dev-full.mjs",
    "smoke:music": "node scripts/music-smoke.mjs",
    "smoke:motion": "node scripts/motion-smoke.mjs",
    "smoke:hls": "node scripts/hls-smoke.mjs",
    "smoke:kinetic": "node scripts/kinetic-smoke.mjs",
    "android:sync": "npm run build && npm run build:backend && cap sync android",
    "android:open": "cap open android",
    "android:apk": "npm run android:sync && node scripts/android-apk.mjs",
    "build:backend": "node scripts/build-embedded-backend.mjs",
    "test:backend": "node scripts/test-embedded-backend.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/core": "8.6.0",
    "@capawesome/capacitor-nodejs": "0.2.0",
