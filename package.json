    "@fontsource/syne": "^5.2.0",
    "@fontsource/unbounded": "^5.2.0",
    "@indic-transliteration/sanscript": "^1.3.3",
    "@vitejs/plugin-react": "latest",
    "bgutils-js": "^4.0.3",
    "express": "^5.3.0",
